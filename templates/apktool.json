  "runtime": {"environment": "apb-native", "java_version": "17"},
  "build": {"engine": "apktool", "output": "dist/", "filename": "DecodedApkProject-unsigned.apk", "offline": true},
  "options": {"sign_apk": true, "zipalign": true}
}
