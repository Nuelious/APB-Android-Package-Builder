{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APB project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "project", "source", "build"],
  "properties": {
    "format": {"const": "APB"},
    "format_version": {"const": 1},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["android-studio", "android-java", "android-kotlin", "apktool", "smali", "dex", "custom"]},
        "description": {"type": "string"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["root"],
      "properties": {
        "root": {"type": "string", "default": "."},
        "manifest": {"type": ["string", "null"]},
        "modules": {"type": "array", "items": {"type": "string"}},
        "smali_directories": {"type": "array", "items": {"type": "string"}},
        "resources": {"type": ["string", "null"]},
        "apktool_file": {"type": ["string", "null"]}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "environment": {"enum": ["apb-native", "apb-linux"]},
        "java_version": {"type": ["string", "null"]},
        "gradle": {"enum": ["project-wrapper", "managed", "system"]}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "output"],
      "properties": {
        "engine": {"enum": ["gradle", "apktool", "smali", "dex", "custom"]},
        "task": {"type": ["string", "null"]},
        "variant": {"type": ["string", "null"]},
        "output": {"type": "string"},
        "filename": {"type": ["string", "null"]},
        "offline": {"type": "boolean", "default": false}
      }
    },
    "options": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "clean_before_build": {"type": "boolean", "default": false},
        "sign_apk": {"type": "boolean", "default": true},
        "zipalign": {"type": "boolean", "default": true},
        "minify": {"type": "boolean", "default": false}
      }
    }
  }
}
